# Generated by `astro build`/`astro dev`, not by hand.
web/src/env.d.ts
# The symlink that exposes repo-root chapters/ to the content collection. CI
# recreates it (see deploy.yml); committing it would break checkouts on systems
# without symlink support.
web/src/content/kapitler
# Deliberately absent: CI runs `npm install`, not `npm ci`. A lockfile generated
# behind a corporate proxy registry would pin URLs that GitHub's runner cannot
# reach. See the note in .github/workflows/deploy.yml before adding one.
web/package-lock.json
